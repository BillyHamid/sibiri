# ═══════════════════════════════════════════════════════════════════════════
# SIBIRI Holding — configuration Apache / LiteSpeed (hébergement o2switch)
#
# Ce fichier est dans public/, donc Vite le recopie tel quel dans dist/ à
# chaque build : il part avec le site, on n'a jamais à le remettre à la main.
#
# Il remplace vercel.json, qui ne sert qu'à Vercel.
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. Renvoi des URL vers l'application ───────────────────────────────────
# Le site est une SPA React : le serveur ne connaît qu'un seul fichier,
# index.html. Sans cette règle, ouvrir directement https://.../energy/services
# ou rafraîchir la page renvoie une 404 d'Apache, parce qu'aucun dossier
# « energy/services » n'existe sur le disque.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forcer le HTTPS.
  # NE PAS tester %{HTTPS} ici : chez Gandi Simple Hosting (et derrière tout
  # proxy qui termine le TLS en amont), Apache reçoit la requête en clair et
  # %{HTTPS} ne vaut jamais "on" — la règle redirige alors vers elle-même,
  # à l'infini. On ne se fie donc qu'à l'en-tête transmis par le proxy, et
  # seulement s'il affirme explicitement que l'origine était en HTTP.
  # S'il est absent, on ne redirige pas : mieux vaut ne rien faire que boucler.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Seul un FICHIER réellement présent est servi tel quel.
  # Surtout pas les dossiers : /medical, /groupe et /energy sont à la fois des
  # routes de l'application ET des dossiers de médias. Si on les laissait
  # passer, Apache ajouterait un slash final (301) puis refuserait de lister
  # leur contenu (403), et la page React ne serait jamais atteinte.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Tout le reste est confié à l'application, qui gère elle-même la route.
  RewriteRule . /index.html [L]
</IfModule>

# ── 2. Compression ─────────────────────────────────────────────────────────
# Le bundle JS fait 975 Ko ; compressé il tombe à ~262 Ko.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# ── 3. Cache ───────────────────────────────────────────────────────────────
# Les fichiers de /assets portent un hachage dans leur nom (index-Ciifs0fY.js) :
# une nouvelle version = un nouveau nom, donc on peut les garder un an.
# index.html, en revanche, ne doit JAMAIS être mis en cache : c'est lui qui
# désigne les fichiers à charger. S'il est en cache, le visiteur continue de
# voir l'ancienne version du site après une mise en ligne.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 6 months"
  ExpiresByType image/png               "access plus 6 months"
  ExpiresByType image/webp              "access plus 6 months"
  ExpiresByType image/svg+xml           "access plus 6 months"
  ExpiresByType video/mp4               "access plus 6 months"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ── 4. Types MIME ──────────────────────────────────────────────────────────
# Certaines configurations mutualisées ne connaissent pas ces extensions et
# les servent en text/plain, ce qui casse le chargement.
<IfModule mod_mime.c>
  AddType application/javascript          .js .mjs
  AddType image/svg+xml                   .svg
  AddType font/woff2                      .woff2
  AddType image/webp                      .webp
</IfModule>

# ── 5. Divers ──────────────────────────────────────────────────────────────
Options -Indexes

# Empêche Apache de transformer /medical en redirection vers /medical/ quand un
# dossier de ce nom existe. Sans cette ligne, la redirection est émise AVANT nos
# règles de réécriture et court-circuite l'application.
DirectorySlash Off

ErrorDocument 404 /index.html
